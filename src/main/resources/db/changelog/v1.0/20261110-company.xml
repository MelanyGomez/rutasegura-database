<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- Crear tabla de empresas -->
    <changeSet id="20261111-create-company" author="melany">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="company"/>
            </not>
        </preConditions>

        <createTable tableName="company">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"
                             primaryKeyName="pk_company"
                             nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>

            <column name="tax_id" type="VARCHAR(13)">
                <constraints nullable="false"/>
            </column>

            <column name="email" type="VARCHAR(150)"/>

            <column name="phone" type="VARCHAR(20)"/>

            <column name="address" type="VARCHAR(500)"/>

            <column name="status_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <!-- Auditoría -->
            <column name="ts_created" type="TIMESTAMP WITH TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="us_created" type="BIGINT"/>
            <column name="ts_modified" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="us_modified" type="BIGINT"/>
            <column name="ts_deleted" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="us_deleted" type="BIGINT"/>
        </createTable>

        <addUniqueConstraint
                tableName="company"
                columnNames="tax_id"
                constraintName="uq_company_tax_id"/>

        <createIndex
                tableName="company"
                indexName="idx_company_status">
            <column name="status_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="company"/>
        </rollback>
    </changeSet>

    <!-- Relacionar empresa con su estado -->
    <changeSet id="20261111-fk-company-status" author="melany">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="company"/>
            <tableExists tableName="cat_status"/>
            <not>
                <foreignKeyConstraintExists
                        foreignKeyName="fk_company_status"/>
            </not>
        </preConditions>

        <addForeignKeyConstraint
                baseTableName="company"
                baseColumnNames="status_id"
                constraintName="fk_company_status"
                referencedTableName="cat_status"
                referencedColumnNames="id"/>

        <rollback>
            <dropForeignKeyConstraint
                    baseTableName="company"
                    constraintName="fk_company_status"/>
        </rollback>
    </changeSet>

    <!-- Relacionar auditoría con usuarios -->
    <changeSet id="20261111-fk-company-audit" author="melany">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="company"/>
            <not>
                <foreignKeyConstraintExists
                        foreignKeyName="fk_company_created_by"/>
            </not>
        </preConditions>

        <addForeignKeyConstraint
                baseTableName="company"
                baseColumnNames="us_created"
                constraintName="fk_company_created_by"
                referencedTableName="app_user"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                baseTableName="company"
                baseColumnNames="us_modified"
                constraintName="fk_company_modified_by"
                referencedTableName="app_user"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                baseTableName="company"
                baseColumnNames="us_deleted"
                constraintName="fk_company_deleted_by"
                referencedTableName="app_user"
                referencedColumnNames="id"/>

        <rollback>
            <dropForeignKeyConstraint
                    baseTableName="company"
                    constraintName="fk_company_deleted_by"/>
            <dropForeignKeyConstraint
                    baseTableName="company"
                    constraintName="fk_company_modified_by"/>
            <dropForeignKeyConstraint
                    baseTableName="company"
                    constraintName="fk_company_created_by"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
